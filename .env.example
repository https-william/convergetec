# ConvergeTec Environment Configuration
# Copy this file to .env.local for local testing, or add to your Vercel Environment Variables

# 1. GoHighLevel Calendar Booking Widget URL
# Where to find in GHL: Calendars -> Calendar Settings -> Share -> Embed Code / Direct Link
# Example: https://api.leadconnectorhq.com/widget/booking/YOUR_CALENDAR_ID
VITE_GHL_CALENDAR_URL=

# 2. GoHighLevel Webhook URL for Direct Contact / Product Demo Requests
# Where to find in GHL: Automation -> Workflows -> Create Workflow -> Trigger: "Inbound Webhook"
# Leads submitted through the custom contact form will automatically flow into GHL CRM
# Example: https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_WEBHOOK_ID
VITE_GHL_WEBHOOK_URL=

# (Optional) Legacy GHL Form URL fallback
VITE_GHL_FORM_URL=
